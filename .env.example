# ============================================================
# COACH MALEK — Backend environment variables
# Copy to .env for local dev. In EasyPanel, add each of these
# under the backend service's "Environment" tab.
# NEVER commit a real .env file. This file contains no real
# secrets — every value below is a placeholder.
# ============================================================

NODE_ENV=production
PORT=4000

# --- Database (EasyPanel Postgres service, or any managed Postgres) ---
# Migrations run automatically on container start — see docs/09-database-and-migrations.md
DATABASE_URL=postgresql://aw_malek:REPLACE_ME@postgres:5432/aw_malek?schema=public

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=https://awmalek.ch,https://www.awmalek.ch

# --- Google Sheets sync (see docs/06-google-sheets-integration.md) ---
# GOOGLE_SHEETS_WEBHOOK_URL is the Apps Script "Web app" /exec URL.
# GOOGLE_SHEETS_WEBHOOK_SECRET must exactly match the SHARED_SECRET
# constant set inside google-apps-script/lead-sync.gs.js.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=REPLACE_ME_LONG_RANDOM_SECRET

# --- Meta (Facebook/Instagram) Conversions API ---
# Get PIXEL_ID from Events Manager > Data Sources.
# Get ACCESS_TOKEN from Events Manager > Settings > Conversions API > Generate access token.
META_PIXEL_ID=REPLACE_ME
META_ACCESS_TOKEN=REPLACE_ME
# Optional: Events Manager > Test Events tab, used only while QA-ing, remove for production traffic.
META_TEST_EVENT_CODE=

# --- TikTok Events API ---
# Get PIXEL_ID (aka Pixel Code) and ACCESS_TOKEN from TikTok Ads Manager > Assets > Events > Web Events > Manage > API access token.
TIKTOK_PIXEL_ID=REPLACE_ME
TIKTOK_ACCESS_TOKEN=REPLACE_ME

# --- Snapchat Conversions API ---
# Get PIXEL_ID from Snapchat Ads Manager > Events Manager.
# Get ACCESS_TOKEN via Snap Business API OAuth (long-lived token) — see https://developers.snap.com/marketing-api/Conversions-API
SNAPCHAT_PIXEL_ID=REPLACE_ME
SNAPCHAT_ACCESS_TOKEN=REPLACE_ME

# --- Default phone region for E.164 normalization (see docs/05-tracking-pixels-and-capi.md) ---
DEFAULT_PHONE_REGION=CH

# --- Rate limiting (protects /api/leads from abuse) ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# --- Optional: lead notification email/Slack webhook so the coach
#     is pinged the moment a new lead comes in, independent of the
#     Sheet/dashboard ---
NOTIFY_EMAIL_TO=coach@awmalek.ch
RESEND_API_KEY=REPLACE_ME
SLACK_WEBHOOK_URL=

# --- Logging ---
LOG_LEVEL=info

# ============================================================
# FUTURE (see docs/12-roadmap-future-features.md) — not required
# for v1 launch, documented here so the schema is ready when
# these features are turned on.
# ============================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JWT_SECRET=
